# Copy to /mnt/warm/laya-service/npu-backend/runtime.env and edit for your RK1.
LAYA_MODEL_DIR=/mnt/warm/laya/checkpoints/laya
LAYA_RKNN_GRAPH_ROOT=/mnt/warm/laya/rknn-models
LAYA_RKNNRT=/mnt/warm/laya/lib/librknnrt.so
LAYA_NPU_FULL_BIND=0.0.0.0:8003
LAYA_NPU_PRELOAD=english,multilingual,typed-decisions
LAYA_NPU_CACHE_BUCKETS=1
LAYA_NPU_KEEP_CACHES=1
LAYA_NPU_FUSED_BLOCKS=1
LAYA_NPU_FUSED_GROUP=14
LAYA_NPU_WINDOW_QUERY=256
